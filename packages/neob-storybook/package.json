{
	"name": "neob-storybook",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"devDependencies": {
		"cf": "1.0.0-beta.12",
		"wrangler": "4.145.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"build": "cf build",
		"deploy": "cf deploy --prebuilt",
		"deploy:dry-run": "cf deploy --prebuilt --dry-run",
		"preview:dry-run": "cf workers versions create --prebuilt --dry-run"
	}
}
